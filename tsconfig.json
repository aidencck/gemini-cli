{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "react", "ink", "vitest/globals"],
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "typeRoots": [
      "./node_modules/@types",
      "./packages/cli/src/types"
    ],
    "target": "es2022"
  }
}
